{
  "manifest_version": 3,
  "name": "GPT Bridge",
  "version": "0.0.1",
  "description": "로컬 GPT 브릿지 서버(127.0.0.1:3010)와 WebSocket으로 연결되는 background 클라이언트",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:3010/*", "https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content_main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content_isolated.js"],
      "run_at": "document_idle"
    }
  ]
}
